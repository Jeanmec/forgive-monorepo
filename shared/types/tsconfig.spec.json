// apps/forgive-front/tsconfig.spec.json
{
  "extends": "./tsconfig.json", // Make sure to extend the base configuration
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "allowSyntheticDefaultImports": true,
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "composite": true,
    "declaration": true,
    "noEmit": true
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "references": [
    // Add this line to reference the shared types package
    { "path": "../../shared/types" }
  ]
}
