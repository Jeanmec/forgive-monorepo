{
  "compileOnSave": false,
  "compilerOptions": {
    "noEmitOnError": true,
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@forgive-monorepo/shared/types": ["shared/types/src/index.ts"],
      "@forgive-monorepo/shared/validation": ["shared/validation/src/index.ts"]
    },
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "tmp"]
}
